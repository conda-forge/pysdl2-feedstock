From 20b1ed0ff643d08c511f06c3d1bb9f97fa7e09a6 Mon Sep 17 00:00:00 2001
From: Anonymous Maarten <anonymous.maarten@gmail.com>
Date: Tue, 1 Apr 2025 13:13:45 +0200
Subject: [PATCH 1/3] Detect wayland video driver

---
 sdl2/test/video_test.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/sdl2/test/video_test.py b/sdl2/test/video_test.py
index 14b5e65..b585cb3 100644
--- a/sdl2/test/video_test.py
+++ b/sdl2/test/video_test.py
@@ -11,12 +11,14 @@
 
 # Some tests don't work properly with some video drivers, so check the name
 DRIVER_DUMMY = False
+DRIVER_WAYLAND = False
 DRIVER_X11 = False
 try:
     sdl2.SDL_Init(sdl2.SDL_INIT_VIDEO)
     driver_name = sdl2.SDL_GetCurrentVideoDriver()
     sdl2.SDL_Quit()
     DRIVER_DUMMY = driver_name == b"dummy"
+    DRIVER_WAYLAND = driver_name == b"wayland"
     DRIVER_X11 = driver_name == b"x11"
 except:
     pass

